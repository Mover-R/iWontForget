# ============================================================================
# Bot Gateway — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================================

# ---- Telegram (REQUIRED) ----
TELEGRAM__TOKEN=your_bot_token_here

# ---- Mode ----
# "longpoll" → local development (no webhook needed, just run python -m bot_gateway)
# "webhook"  → production (requires public HTTPS URL below)
TELEGRAM__MODE=longpoll

# ---- Webhook settings (only needed when MODE=webhook) ----
TELEGRAM__WEBHOOK_URL=https://bot.example.com
TELEGRAM__WEBHOOK_PATH=/webhook
TELEGRAM__WEBHOOK_PORT=8443
TELEGRAM__WEBHOOK_SECRET_TOKEN=

# ---- gRPC server (Phase 1+) ----
GRPC__PORT=50051
GRPC__ENABLED=false

# ---- Redis ----
REDIS__ADDR=localhost:6379
REDIS__SESSION_DB=0
REDIS__RATELIMIT_DB=1
REDIS__DEDUP_DB=2
REDIS__PASSWORD=

# ---- Kafka (Phase 1+) ----
KAFKA__BROKERS=["localhost:9092"]
KAFKA__TOPIC_USER_ACTIVITY=user.activity
KAFKA__ENABLED=false

# ---- Backend service addresses (Phase 1+) ----
SERVICES__USER=localhost:50052
SERVICES__WISHLIST=localhost:50053
SERVICES__REMINDER=localhost:50054
SERVICES__FRIENDS=localhost:50055
SERVICES__GIFT=localhost:50056
SERVICES__EVENT=localhost:50057
SERVICES__AI=localhost:50058

# ---- Rate limiting ----
RATELIMIT__GLOBAL_PER_SECOND=30
RATELIMIT__PER_CHAT_PER_SECOND=1

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=console
ENVIRONMENT=development
